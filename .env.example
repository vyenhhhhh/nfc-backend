# ─────────────────────────────────────────────────────────────
#  Backend settings. Copy this file to .env and fill it in.
#  Never commit the real .env to GitHub (this repository is public).
#  After changing .env:  php artisan config:clear
# ─────────────────────────────────────────────────────────────

APP_NAME="CSU CCIS OJT"
# production on the real server, local on your laptop
APP_ENV=local
# make one with:  php artisan key:generate
APP_KEY=
# false on the real server (true shows error details to everyone)
APP_DEBUG=true
# the backend's own address (laptop: http://localhost:8000)
APP_URL=http://localhost:8000

# the React site's address, allowed by CORS. Several: separate with commas.
FRONTEND_URL=http://localhost:5173

# the host's proxy in front of the app: * on most cloud hosting, empty on a laptop or plain server
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Database (Supabase Postgres, Singapore) ──
# Supabase → Project Settings → Database → Connection string (Session pooler)
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
# keep the cache on this computer (faster taps); the kiosk tap lock uses it too
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ── Uploaded files ──
# Public files (profile photos, blank requirement forms):
#   public = this computer (storage/app/public)   supabase = the public Supabase bucket
UPLOADS_DISK=supabase
# Private files (requirement uploads, evaluation forms, school-event proofs, signatures),
# opened only with short-lived links:
#   local = this computer (storage/app/private)   supabase_private = a PRIVATE Supabase bucket
# Moving the old files: php artisan uploads:make-private
PRIVATE_UPLOADS_DISK=local

# Supabase → Project Settings → Storage → S3 Connection (and S3 Access Keys)
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# the PUBLIC bucket (photos, forms) and its public address
SUPABASE_BUCKET=mytrack
SUPABASE_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/mytrack
# the PRIVATE bucket (create it with "Public bucket" OFF)
SUPABASE_PRIVATE_BUCKET=mytrack-private

# ── Kiosks ──
# Leave KIOSK_KEY empty: every kiosk is set up with its own link from Accounts → Kiosks.
# (Anything put here works for every device that knows it.)
KIOSK_KEY=
# one-time card codes: off | on | strict
# strict = every tap must carry a valid card code (when every kiosk is an ACR122U or a phone)
SECURE_CARDS=on

# ── Sign in with Google (same value as VITE_GOOGLE_CLIENT_ID in the React .env) ──
GOOGLE_CLIENT_ID=

# ── Email (temporary passwords, recovery codes) ──
# log = emails are only written to storage/logs (nothing is sent)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# Gmail: an App Password (Google Account → Security → App passwords), not the normal password
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
